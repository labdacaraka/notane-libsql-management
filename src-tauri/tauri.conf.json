{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notane LibSQL Management",
  "version": "0.1.0",
  "identifier": "com.notane.libsql-management",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notane LibSQL Management",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Self-hosted libSQL (sqld) Database Server Management and Monitoring",
    "longDescription": "Desktop application and server engine to manage, monitor, and connect self-hosted libSQL (sqld) database instances on local networks and remote environments.",
    "copyright": "Copyright © 2026 Notane. All rights reserved.",
    "publisher": "Notane",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "curl",
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libssl3 | libssl1.1"
        ]
      }
    }
  }
}
